{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://api.sgpf.com.br/auth/:path*"
    },
    {
      "source": "/folio/:path*",
      "destination": "https://api.sgpf.com.br/folio/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.sgpf.com.br/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
